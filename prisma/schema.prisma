generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  email     String?   @unique
  password  String
  avatar    String    @default("https://imagedelivery.net/zRDsOnXdrMQRT3BoRETbLA/a6bec09e-1607-4c2a-e2c1-2f7eec4d5300/avatar")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Article   Article[]
  Like      Like[]
}

model Article {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  thumbnail   String?
  content     String
  published   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  views       Int          @default(0)
  tags        ArticleTag[]
  user        User         @relation(fields: [userId], references: [id])
  userId      Int
  Like        Like[]
}

model ArticleTag {
  articleId Int
  tagId     Int
  article   Article @relation(fields: [articleId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([articleId, tagId])
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  articles ArticleTag[]
}

model Like {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  article   Article  @relation(fields: [articleId], references: [id])
  articleId Int
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
}
